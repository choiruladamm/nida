    "Jadwal asli tersedia di menu bar dan notch. Pengingat otomatis aktif saat Nida berjalan dan Mac terjaga. Tombol coba pengingat memakai data contoh.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal asli tersedia di menu bar dan notch. Pengingat otomatis aktif saat Nida berjalan dan Mac terjaga. Tombol coba pengingat memakai data contoh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live schedules are available in the menu bar and notch. Reminders run while Nida is open and your Mac is awake. Preview buttons use sample data."
          }
        }
      }
    },
