    "Ada lebih dari satu wilayah yang cocok. Pilih kota atau kabupaten manual agar jadwal tepat.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada lebih dari satu wilayah yang cocok. Pilih kota atau kabupaten manual agar jadwal tepat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one area matches. Choose a city or regency manually for the right schedule."
          }
        }
      }
    },
    "Akses lokasi tidak diizinkan. Pilih kota manual, atau izinkan Nida di Pengaturan Sistem → Privasi & Keamanan → Layanan Lokasi.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi tidak diizinkan. Pilih kota manual, atau izinkan Nida di Pengaturan Sistem → Privasi & Keamanan → Layanan Lokasi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is denied. Choose a city manually, or allow Nida in System Settings → Privacy & Security → Location Services."
